# DOGE PRINT AGENT - CONFIGURAZIONE LOCALE
# Copiare questo file in .env sul PC della pizzeria.

# Supabase
SUPABASE_URL=https://INSERISCI-PROGETTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=INSERISCI_SERVICE_ROLE_KEY

# Stampante Windows
WINDOWS_PRINTER_NAME=EPSON BAR

# Stampante Epson di rete rilevata su Windows
PRINTER_HOST=192.168.1.192
PRINTER_PORT=9100

# Modalita stampa
PRINT_MODE=windows
POLL_INTERVAL_MS=5000

# Tabelle Supabase: modificabili se nel progetto hanno nomi diversi
ORDERS_TABLE=orders
TABLE_PAYMENTS_TABLE=table_payments

# Sicurezza anti-doppia stampa
PRINT_STATUS_PENDING=pending
PRINT_STATUS_PRINTED=printed
PRINT_STATUS_ERROR=error
